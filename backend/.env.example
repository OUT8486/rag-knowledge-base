# First run: python -m app.manage init (creates independent random pilot credentials).
RAG_AUTH_MODE=token
# RAG_DATA_DIR=<absolute path>; defaults to backend/data/enterprise, separate from the legacy index.
# RAG_ACCESS_FILE=<absolute path to access.json>
# For a private trusted SSO gateway only: RAG_AUTH_MODE=proxy and RAG_GATEWAY_KEY=<at least 32 random characters>

# Only these variables are used by local_only KBs. Start your trusted local inference server separately.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Only used after an administrator explicitly marks a KB approved_cloud.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
