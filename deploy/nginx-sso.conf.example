# Example server block. Replace site name, certificate paths and web root before use.
# oauth2-proxy listens only on 127.0.0.1:4180; uvicorn only on 127.0.0.1:8000.
server {
    listen 443 ssl;
    server_name knowledge.example.internal;
    ssl_certificate /etc/knowledgeflow/tls.crt;
    ssl_certificate_key /etc/knowledgeflow/tls.key;
    root /srv/knowledgeflow/frontend/dist;
    client_max_body_size 11m;

    location = /oauth2/auth {
        internal;
        proxy_pass http://127.0.0.1:4180;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Original-URI $uri;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /oauth2/ {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location @login { return 302 /oauth2/start?rd=/; }
    location / {
        auth_request /oauth2/auth;
        error_page 401 = @login;
        try_files $uri $uri/ /index.html;
    }
    location /api/ {
        auth_request /oauth2/auth;
        auth_request_set $rag_user $upstream_http_x_auth_request_user;
        auth_request_set $rag_groups $upstream_http_x_auth_request_groups;
        # Must set (not forward) all three identity headers. File readable by the gateway only.
        # Contains exactly: proxy_set_header X-RAG-Gateway-Key "<same random secret as backend>";
        include /etc/knowledgeflow/gateway-key.conf;
        proxy_set_header X-RAG-User $rag_user;
        proxy_set_header X-RAG-Groups $rag_groups;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Host $host;
        proxy_read_timeout 125s;
        proxy_pass http://127.0.0.1:8000;
    }
}
